+package org.springframework.expression.spel;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.expression.common.ExpressionUtils;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Functional checks for the controlled expression-evaluation convenience method.
+ * @author Arup Halder
+ */
+class ExpressionUtilsConvenienceTests {
+
+	@Test
+	void evaluatesArithmetic() {
+		assertThat(ExpressionUtils.evaluate("6 * 7")).isEqualTo(42);
+	}
+
+	@Test
+	void evaluatesStringOperation() {
+		assertThat(ExpressionUtils.evaluate("'spring'.toUpperCase()"))
+				.isEqualTo("SPRING");
+	}
+
+	@Test
+	void evaluatesNull() {
+		assertThat(ExpressionUtils.evaluate("null")).isNull();
+	}
+
+}
